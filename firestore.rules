rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user has Firebase admin custom claim (admin == true)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // 1. User Profiles: public nickname, level, stats
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) 
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 12;
      allow update: if (isOwner(userId) || isAdmin())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'createdAt']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname']) 
            || (request.resource.data.nickname is string && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 12));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Private User Profiles (Sensitive user settings)
    match /privateProfiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Game Sessions: Temporary sessions, guest tracking
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated() || isAdmin();
      allow delete: if isAuthenticated() || isAdmin();
    }

    // 4. Leaderboards & Rankings: Public read, authenticated creation
    match /rankings/{recordId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
      allow update, delete: if isAdmin();
    }
  }
}
